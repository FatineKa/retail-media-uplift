{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RetailMediaUpliftS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::retail-media-uplift-fatin",
        "arn:aws:s3:::retail-media-uplift-fatin/*"
      ]
    }
  ]
}
